{
  "name": "pdf-viewer-dark",
  "displayName": "PDF Viewer & PDF Reader with Dark Mode",
  "description": "PDF viewer and PDF reader for VS Code with a real dark mode that keeps photos in their true colors, plus search, an outline, thumbnails and zoom, all offline.",
  "version": "0.2.4",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B1F2A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf reader",
    "pdf viewer",
    "pdf",
    "pdf dark mode",
    "view pdf",
    "pdf preview",
    "read pdf",
    "open pdf",
    "dark mode",
    "dark pdf",
    "night mode",
    "latex preview",
    "latex",
    "pdf search",
    "find in pdf",
    "outline",
    "bookmarks",
    "table of contents",
    "thumbnails",
    "zoom",
    "pdf.js",
    "pdfjs",
    "document",
    "viewer",
    "reader",
    "preview",
    "paper",
    "arxiv",
    "ebook",
    "offline"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.preview",
        "displayName": "PDF Reader",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pdfViewer.toggleDarkMode",
        "title": "Toggle Dark Pages",
        "category": "PDF",
        "icon": "$(color-mode)"
      },
      {
        "command": "pdfViewer.find",
        "title": "Find in PDF",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.zoomIn",
        "title": "Zoom In",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.zoomOut",
        "title": "Zoom Out",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.fitWidth",
        "title": "Fit Width",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.fitPage",
        "title": "Fit Page",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.toggleSidebar",
        "title": "Toggle Outline and Pages",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.goToPage",
        "title": "Go to Page...",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.copyPageLink",
        "title": "Copy Link to This Page",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.forgetPositions",
        "title": "Forget Last Page of All PDFs",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.openWith",
        "title": "Open with PDF Reader",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "PDF"
      },
      {
        "command": "pdfViewer.moreViewers",
        "title": "More free viewers",
        "category": "PDF"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pdfViewer.toggleDarkMode",
          "when": "activeCustomEditorId == pdfViewer.preview",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pdfViewer.openWith",
          "when": "resourceExtname == .pdf",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "pdfViewer.toggleDarkMode",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.find",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.zoomIn",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.zoomOut",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.fitWidth",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.fitPage",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.toggleSidebar",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.goToPage",
          "when": "activeCustomEditorId == pdfViewer.preview"
        },
        {
          "command": "pdfViewer.copyPageLink",
          "when": "activeCustomEditorId == pdfViewer.preview"
        }
      ]
    },
    "configuration": {
      "title": "PDF Reader",
      "properties": {
        "pdfViewer.darkMode": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Dark pages when the VS Code theme is dark or high contrast dark.",
            "Always dark pages.",
            "Never dark pages. Show the PDF as printed."
          ],
          "default": "auto",
          "description": "When to show PDF pages dark. The moon button in the toolbar switches it for the open file."
        },
        "pdfViewer.keepImagesInDarkMode": {
          "type": "boolean",
          "default": true,
          "description": "In dark mode, keep photos and other raster images in their original colors. Text, lines and backgrounds are still darkened."
        },
        "pdfViewer.defaultZoom": {
          "type": "string",
          "enum": [
            "page-width",
            "page-fit"
          ],
          "enumDescriptions": [
            "Fit the page width to the editor.",
            "Fit the whole page in the editor."
          ],
          "default": "page-width",
          "description": "Zoom for a PDF that you open for the first time."
        },
        "pdfViewer.rememberLastPage": {
          "type": "boolean",
          "default": true,
          "description": "Reopen each PDF at the page and zoom where you left it. Stored locally in VS Code, for up to 500 files."
        },
        "pdfViewer.sidebar": {
          "type": "string",
          "enum": [
            "closed",
            "open",
            "remember"
          ],
          "enumDescriptions": [
            "Start with the sidebar closed. It never opens by itself, also not for PDFs with an outline.",
            "Open the outline and pages sidebar for every PDF.",
            "Open it or keep it closed the way you left it in the last PDF."
          ],
          "default": "closed",
          "description": "Whether the outline and pages sidebar is open when you open a PDF."
        },
        "pdfViewer.maxFileSizeMB": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Ask before opening PDFs larger than this, in MB."
        },
        "pdfViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask one time for a Marketplace rating after you have used PDF Viewer for a few days. You can answer \"Later\" or \"Don't ask again\". Nothing is sent anywhere."
        },
        "pdfViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the viewer. The change shows in files you open next. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "pdfViewer.start",
        "title": "Get started with PDF Reader",
        "description": "Open a PDF, read it in dark mode, search it and jump through its outline.",
        "steps": [
          {
            "id": "open",
            "title": "Open a PDF",
            "description": "Click any .pdf file in the Explorer. It opens in this viewer.\n[Open a PDF file](command:pdfViewer.openWith)",
            "media": {
              "image": "images/walkthrough-light.png",
              "altText": "A PDF open in the viewer with a light theme."
            },
            "completionEvents": [
              "onCommand:pdfViewer.openWith"
            ]
          },
          {
            "id": "dark",
            "title": "Switch dark pages on or off",
            "description": "Pages follow your theme. The moon button in the PDF toolbar switches dark pages for this file. Photos keep their colors.\n[Toggle dark pages](command:pdfViewer.toggleDarkMode)",
            "media": {
              "image": "images/walkthrough-dark.png",
              "altText": "Dark pages with a map image in its original colors."
            },
            "completionEvents": [
              "onCommand:pdfViewer.toggleDarkMode"
            ]
          },
          {
            "id": "find",
            "title": "Search and jump",
            "description": "Press Ctrl+F (Cmd+F on macOS) in the PDF, type, then Enter for the next match. Open the sidebar for the outline and page thumbnails.\n[Open settings](command:workbench.action.openSettings?%5B%22pdfViewer%22%5D)",
            "media": {
              "markdown": "walkthrough/keys.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.openSettings"
            ]
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "pdfViewer.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == pdfViewer.preview && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inQuickOpen"
      },
      {
        "command": "pdfViewer.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == pdfViewer.preview && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inQuickOpen"
      },
      {
        "command": "pdfViewer.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == pdfViewer.preview && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inQuickOpen"
      },
      {
        "command": "pdfViewer.goToPage",
        "key": "ctrl+g",
        "when": "activeCustomEditorId == pdfViewer.preview && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !inQuickOpen"
      }
    ]
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdfjs.js",
    "test": "node --test test/*.test.js",
    "test:browser": "python3 test/e2e/run.py",
    "package": "npx -y @vscode/vsce@3 package --no-dependencies -o dist/",
    "test:vscode": "node test/vscode/run.js"
  },
  "devDependencies": {
    "pdfjs-dist": "5.7.284"
  },
  "homepage": "https://github.com/theluckystrike/pdf-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/pdf-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/pdf-viewer-vscode.git"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike"
  }
}
